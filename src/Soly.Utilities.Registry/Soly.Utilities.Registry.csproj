<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Targeting and compiler settings -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <!-- Assembly and package identity -->
        <Version>2.0.0</Version>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>

        <!-- Package metadata -->
        <Authors>Soleil Rojas</Authors>
        <Copyright>Copyright © Soleil Rojas 2022</Copyright>
        <Description>Collection of helper classes for registry access in Windows</Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageOutputPath>$(SolutionDir).artifacts</PackageOutputPath>
        <PackageProjectUrl>https://github.com/Solybum/Utilities/tree/main/src/Soly.Utilities.Registry</PackageProjectUrl>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/Solybum/Utilities</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Update="readme.md">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

</Project>
