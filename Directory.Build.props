<Project>
    <PropertyGroup>
        <ArtifactsDir>$(MSBuildThisFileDirectory).artifacts\</ArtifactsDir>

        <!-- Shared targeting and compiler settings -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Shared assembly and package identity -->
        <PackageId>$(MSBuildProjectName)</PackageId>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>

        <!-- Shared package metadata -->
        <Authors>Soleil Rojas</Authors>
        <Copyright>Copyright © Soleil Rojas 2022</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/Solybum/Utilities</RepositoryUrl>
        <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/readme.md')">readme.md</PackageReadmeFile>
        <PackageOutputPath>$(ArtifactsDir)</PackageOutputPath>
    </PropertyGroup>
</Project>
